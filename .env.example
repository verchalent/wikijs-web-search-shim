# wikijs-search-shim configuration. Copy to .env and edit.
#   cp .env.example .env && chmod 600 .env
# .env is gitignored and dockerignored. Never commit it.

# Wiki.js base URL, no trailing slash. Required — the shim exits if unset.
WIKI_URL=https://wiki.example.lan

# API token. LEAVE BLANK if guests can read the wiki (preferred — see README).
# Wiki.js 2.x tokens are NOT scoped: a token is full admin, including delete.
WIKI_TOKEN=

# Locale passed to the search query.
WIKI_LOCALE=en

# External base URL the shim is reached at. Set this for any proxied deployment;
# it makes OpenSearch templates correct without depending on forwarded headers.
PUBLIC_URL=https://search.example.lan

# Bind address/port inside the container. The image already defaults LISTEN_ADDR
# to 0.0.0.0; override here only if you know why.
#LISTEN_ADDR=0.0.0.0
#LISTEN_PORT=8099

# Shown in the page title, form placeholder, and OpenSearch ShortName (<=16 chars).
SITE_NAME=Wiki

# Seconds before giving up on the GraphQL call.
TIMEOUT=10
